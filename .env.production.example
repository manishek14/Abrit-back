# ============================================================================
# AbrIT — PRODUCTION environment template
# Copy to .env.production and fill in REAL values. NEVER commit the filled file.
# Every value below is validated at boot — the process refuses to start on a
# weak/missing secret (this is by design, see backend/src/config/env.ts).
# ============================================================================

# --- Compose-only ------------------------------------------------------------
HTTP_PORT=80
POSTGRES_USER=abrit
# REQUIRED — generate: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=abrit
# Nightly backup retention in days (db-backup profile)
BACKUP_KEEP_DAYS=14
# The panel MUST be served over HTTPS in production → cookies Secure=true.
# Only set false when TLS terminates at a proxy you fully control.
COOKIE_SECURE=true

# --- Server ------------------------------------------------------------------
# The panel's origin(s) — comma-separated. Behind the bundled nginx the API is
# same-origin, so this is the public site URL:
CORS_ORIGIN=https://your-domain.example
APP_TIMEZONE=Asia/Tehran
NODE_ENV=production

# --- Database ----------------------------------------------------------------
# Composed automatically by docker-compose.prod.yml (host "db") — leave unset
# here unless you point at a MANAGED PostgreSQL instead. For managed DBs:
#   DATABASE_URL=postgres://user:pass@host:5432/abrit?sslmode=require
#   DATABASE_SSL=true            (TLS; add DATABASE_SSL_CA=<PEM> to pin the CA)
# Raw Telegram payloads are purged after N days (conversation is kept).
BOT_UPDATES_RETENTION_DAYS=30

# --- Auth / admin ------------------------------------------------------------
# REQUIRED — generate: openssl rand -hex 32
JWT_SECRET=
# Session lifetime: BOTH the JWT and the session cookie maxAge (one policy).
JWT_EXPIRES_IN=8h
ADMIN_EMAIL=admin@your-domain.example
# REQUIRED in production, 12+ chars, 3 of 4 character classes, not a known default.
ADMIN_PASSWORD=

# --- Telegram ----------------------------------------------------------------
# While empty the integration is DISABLED (readiness reports telegram:
# "disabled" and stays green). With a token, a FAILED bootstrap degrades
# readiness in development and ABORTS the process in production.
TELEGRAM_MODE=webhook
# webhook mode requires all three (use https://your-domain.example/api/telegram/webhook)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_UPDATES=message
# Outbound Telegram request timeout — must stay BELOW the 60 s delivery lease.
TELEGRAM_SEND_TIMEOUT_MS=30000

# --- OpenRouter / AI (optional) ----------------------------------------------
# Empty = the assistant answers with the honest fallback (no network calls).
# Smoke-tested with the owner's key (2026-11-06): openrouter/auto is
# region-blocked (403) — use the verified free model below, or pick one in
# Settings → Assistant (the live model list) once credits are topped up.
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_TIMEOUT_MS=25000
AI_CONTEXT_MAX_MESSAGES=20
AI_MAX_CONCURRENCY=3
AI_MAX_OUTPUT_TOKENS=500
AI_CONTEXT_MAX_CHARS=21000
