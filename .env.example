# ============================================================================
# AbrIT Ticketing System — environment template
# Copy this file to `.env` and adjust:   cp .env.example .env
# Real secrets must never be committed to the repository.
# ============================================================================

# --- Server -----------------------------------------------------------------
PORT=3000
CORS_ORIGIN=http://localhost:5173
APP_TIMEZONE=Asia/Tehran
# development | test | production (production enables strict security rules:
# 32+ char JWT secret, explicit admin password, SEED_DEMO_DATA must be false)
NODE_ENV=development

# --- Database ---------------------------------------------------------------
# With docker compose: postgres://abrit:abrit@127.0.0.1:5432/abrit
DATABASE_URL=postgres://abrit:abrit@127.0.0.1:5432/abrit
# TLS for a MANAGED PostgreSQL (leave empty for local/docker):
# DATABASE_SSL=true enables encryption; DATABASE_SSL_CA (PEM body) additionally
# pins the server certificate; `?sslmode=require` in the URL also works.
DATABASE_SSL=
DATABASE_SSL_CA=
# Run pending migrations automatically on boot (idempotent)
MIGRATIONS_RUN=true
# Seed demo data (Persian sample users/tickets/messages) when the DB is empty.
# DEVELOPMENT ONLY — in production it must be false (validation refuses true).
SEED_DEMO_DATA=true
# Retention for raw Telegram payloads in bot_updates (days). 0 = keep forever.
# Conversation messages are NOT affected by this purge.
BOT_UPDATES_RETENTION_DAYS=30

# --- Auth / first admin (REQUIRED — change in production) -------------------
# No default is provided on purpose; the app refuses to boot without it.
# Generate one:  openssl rand -hex 32
# Known/example values (including this placeholder) are rejected at boot.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARS
# Session lifetime — the JWT and the panel's HttpOnly session cookie share
# this ONE policy. Formats: 45m, 8h, 7d (bare digits = ms).
JWT_EXPIRES_IN=8h
# Session cookie hardening (round 6): HttpOnly + SameSite=Strict always;
# Secure defaults ON in production (HTTPS mandatory there). Override only for
# exotic TLS-terminating proxies.
COOKIE_SECURE=
ADMIN_EMAIL=admin@abrit.local
# Development-only default (Admin1234!) is applied when empty in non-production
# mode; production REQUIRES an explicit strong password here.
ADMIN_PASSWORD=Admin1234!

# --- Telegram (INTENTIONALLY EMPTY FOR NOW) ---------------------------------
# The project owner will provide the real token later. While TELEGRAM_BOT_TOKEN
# is empty the Telegram integration stays disabled and only logs an info message.
TELEGRAM_MODE=polling
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
# 'callback_query' is REQUIRED for /mytickets inline pagination buttons —
# with 'message' alone the buttons render but taps never arrive.
TELEGRAM_ALLOWED_UPDATES=message,callback_query
# Outbound Telegram request timeout (ms) — must stay BELOW the 60 s delivery
# lease (review round 5): a hung request fails fast as TRANSIENT and is
# retried with exponential backoff instead of outliving its claim.
TELEGRAM_SEND_TIMEOUT_MS=30000

# --- OpenRouter / AI ----------------------------------------------------------
# While OPENROUTER_API_KEY is empty the assistant replies with a fixed fallback
# message instead of calling the provider (nothing leaves the machine).
# Model note (real-token smoke test, 2026-11-06): openrouter/auto is
# region-blocked (403) for the owner's key; the default below is verified to
# work with it (good Persian, ~5 s, free tier: 50 requests/day).
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_TIMEOUT_MS=25000
AI_CONTEXT_MAX_MESSAGES=20
AI_MAX_CONCURRENCY=3
AI_MAX_OUTPUT_TOKENS=500
AI_CONTEXT_MAX_CHARS=21000
